{
  "manifest_version": 3,
  "name": "Check List Checker",
  "version": "1.0.0",
  "description": "输入列表数据，逐条检查通过/不通过，自动生成检查结果",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Check List Checker"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
