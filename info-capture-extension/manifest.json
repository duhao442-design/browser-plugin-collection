{
  "manifest_version": 3,
  "name": "关键信息捕获",
  "version": "1.0.0",
  "description": "捕获题目ID、队列名称、题目链接、alloc镜像image四类关键信息，以制表符分隔",
  "permissions": ["activeTab", "scripting", "storage", "clipboardRead", "clipboardWrite"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "关键信息捕获"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
